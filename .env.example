# Copy to .env and edit. Every value is optional (defaults shown).
CRAWLER_SEEDS=https://quotes.toscrape.com/
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=50
CRAWLER_CONCURRENCY=5
CRAWLER_DELAY=1.0
CRAWLER_TIMEOUT=10
CRAWLER_RETRIES=3
CRAWLER_BACKOFF=1.5
CRAWLER_USER_AGENT=PyCrawlerBot/1.0 (+https://github.com/your-user/web-crawler)
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_OUTPUT_DIR=output
CRAWLER_LOG_LEVEL=INFO
CRAWLER_LOG_FILE=logs/crawler.log
